{
  "//": "GENERATED by hl harness sync 5ebf41a07315. Edit harness/harness.toml, then run hl harness sync.",
  "permissions": {
    "allow": [
      "Bash(hl:*)"
    ],
    "deny": [
      "Edit(artifacts/**/ticket.toml)",
      "Write(artifacts/**/ticket.toml)",
      "Edit(logs/**)",
      "Write(logs/**)",
      "Edit(workspace.toml)",
      "Write(workspace.toml)",
      "Read(.env)",
      "Read(site/**)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/plugins/harness/hooks/session-start.ts\" --host claude -- context --session",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/plugins/harness/hooks/post-edit.ts\" --host claude -- validate --changed",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/plugins/harness/hooks/stop.ts\" --host claude --policy harness/harness.toml -- log show",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
