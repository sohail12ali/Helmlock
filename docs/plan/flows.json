 {
  "title": "Ticket lifecycle: compact, archive, delete",
  "note": "Closing writes a short digest and hides drafts. After a window the ticket is archived with a hash manifest and can be restored. Deleting is allowed only for archived tickets, after a dry run, a typed confirmation and a value check, and leaves a tombstone.",
  "nodes": [
   {
    "id": "act",
    "label": "Active ticket (small, capped)",
    "type": "start"
   },
   {
    "id": "close",
    "label": "Close: write the digest, move drafts to _work/"
   },
   {
    "id": "closed",
    "label": "Closed: digest visible, drafts hidden"
   },
   {
    "id": "arch",
    "label": "Archive after about 30 days: dry run, manifest"
   },
   {
    "id": "archived",
    "label": "Archived: archive/YYYY-MM/T-xxx, restorable"
   },
   {
    "id": "value",
    "label": "Purge after about 180 days: dry run, typed confirm, value check",
    "type": "decision"
   },
   {
    "id": "gone",
    "label": "Deleted: tombstone kept",
    "type": "end"
   }
  ],
